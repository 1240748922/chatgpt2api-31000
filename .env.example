# By default, follow the image selected by docker-compose.yml after git pull.
# Uncomment to keep a specific version across future repository updates.
# CHATGPT2API_IMAGE_TAG=sha-eb4cf61
POSTGRES_DB=chatgpt2api
POSTGRES_USER=chatgpt2api
POSTGRES_PASSWORD=replace-with-a-long-random-password
CHATGPT2API_AUTH_KEY=replace-with-a-long-random-admin-key
CHATGPT2API_MONITOR_CLUSTER_SECRET=replace-with-a-long-random-cluster-secret
# Used by the maintenance and CPU super-resolution image (sha-eb4cf61).
# Optional operator label shown by GET /version. It does not change the image.
# CHATGPT2API_BUILD_VERSION=release-2026-09-17-a
# Optional build timestamp shown by GET /version.
# CHATGPT2API_BUILD_TIME=2026-09-17T00:00:00+08:00
CHATGPT2API_MAINTENANCE_IMAGE_ACTIVE_MAX=2
CHATGPT2API_MAINTENANCE_IMAGE_WAITING_MAX=0
CHATGPT2API_MAINTENANCE_RETRY_SECONDS=30
CHATGPT2API_IMAGE_UPSCALE_CONCURRENCY=64
CHATGPT2API_FSRCNN_CONCURRENCY=64
CHATGPT2API_FSRCNN_THREADS=1
CHATGPT2API_UPLOAD_COOLDOWN_SECONDS=900
CHATGPT2API_MAINTENANCE_BATCH_CONCURRENCY=2
CHATGPT2API_UNKNOWN_QUOTA_SYNC_BATCH_SIZE=50
CHATGPT2API_DATA_DIR=./data
CHATGPT2API_CONFIG_FILE=./config.json
REGISTER_TOOL_CONFIG_FILE=./GPT-Register-Tool-main/config.json
REGISTER_TOOL_SESSIONS_DIR=./GPT-Register-Tool-main/sessions
REGISTER_TOOL_RUNTIME_DIR=./GPT-Register-Tool-main/runtime
